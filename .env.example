# โดเมนจริงของร้าน — ใช้สร้าง canonical URL, sitemap.xml, robots.txt, OG image และ JSON-LD
# ต้องเป็น absolute URL และห้ามมี / ปิดท้าย
NEXT_PUBLIC_SITE_URL="https://www.example.com"
# Google Search Console verification (วางเฉพาะค่า content ของ meta tag)
GOOGLE_SITE_VERIFICATION=""

# PostgreSQL database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Admin CMS authentication — ห้าม commit ค่าใช้งานจริง
ADMIN_PASSWORD="เปลี่ยนเป็นรหัสผ่านที่เดายาก"
ADMIN_SESSION_SECRET="เปลี่ยนเป็น random secret ยาวอย่างน้อย 32 ตัวอักษร"

DIGITALOCEAN_SPACES_ACCESS_KEY_ID=""
DIGITALOCEAN_SPACES_SECRET_ACCESS_KEY=""
DIGITALOCEAN_SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
DIGITALOCEAN_SPACES_BUCKET=""
DIGITALOCEAN_SPACES_DEV_NAMESPACE="tamiya-premium/dev"
DIGITALOCEAN_SPACES_PROD_NAMESPACE="tamiya-premium/prod"

# Authentication
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
OTP_PROVIDER_API_KEY=""

# Payment QR / PromptPay
PROMPTPAY_ID=""
PAYMENT_WEBHOOK_SECRET=""

CUSTOMER_SESSION_SECRET="เปลี่ยนเป็น random secret ยาวอย่างน้อย 32 ตัวอักษร"
FACEBOOK_REDIRECT_URI=""

# Slip verification (slip2go)
SLIP2GO_API_KEY=""
SLIP2GO_API_BASE="https://connect.slip2go.com"

# Cron job ที่คืนสต็อกออเดอร์หมดอายุ — ต้องตรงกับที่ scheduler ส่งมา
CRON_SECRET=""

# SMS gateway สำหรับส่ง OTP (send-sms.in.th)
SMS_API_BASE="https://api.send-sms.in.th"
SMS_API_KEY=""
SMS_CLIENT_ID=""
SMS_SENDER_ID=""
